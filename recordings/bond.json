{
  "id": "bond",
  "name": "Bond DvP",
  "tagline": "Public Sepolia USDC ⇄ private Noto bond, settled atomically",
  "concept": "Noto + Pente: the notary — and the regulator as a group observer — can see balances and positions. The outside world sees only state hashes and the public USDC leg.",
  "columns": [
    "issuer",
    "custodian",
    "investor",
    "regulator",
    "sepolia",
    "base"
  ],
  "viewers": [
    "omniscient",
    "issuer",
    "custodian",
    "investor",
    "regulator",
    "public"
  ],
  "steps": [
    {
      "title": "Issue cash on Ethereum Sepolia",
      "plain": "Bank A already holds a public USDC stablecoin balance on Ethereum Sepolia. This is the cash leg — fully public, like any ERC-20.",
      "tech": "ERC-20 USDC · chainId 11155111 · balanceOf(BankA) = 100,000",
      "badges": [
        "pub"
      ]
    },
    {
      "title": "Form the Issuer ⇄ Custodian privacy group",
      "plain": "The Bond Depository and Bank B spin up a private EVM group (Pente). Only its members — and the regulator, added as an observer — can see what happens inside. The base ledger only ever stores a hash of its state.",
      "tech": "PenteFactory.newPrivacyGroup({ members:[issuer,custodian], evmVersion:\"shanghai\" })",
      "badges": [
        "priv"
      ]
    },
    {
      "title": "Deploy the bond — Noto token + private tracker",
      "plain": "A Noto bond token is deployed. Its policy lives in a private ERC-20 \"tracker\" inside the privacy group (Noto hooks). The public bond tracker advertises face value & maturity to everyone.",
      "tech": "Noto.newNoto({ notary:custodian, notaryMode:\"hooks\" }) → hooks: BondTracker (private)",
      "badges": [
        "priv",
        "pub"
      ]
    },
    {
      "title": "Issue bond units to the custodian",
      "plain": "The issuer mints 1,000 bond units into the custodian’s care. Inside the group everyone sees the position; the public ledger only learns that issuance started.",
      "tech": "notoBond.mint({ to:custodian, amount:1000 }) → onMint hook → public tracker",
      "badges": [
        "priv",
        "pub"
      ]
    },
    {
      "title": "Open distribution · allow-list Bank A",
      "plain": "The custodian opens the bond for subscription and adds Bank A to the private allow-list. Who is allowed in is private to the group.",
      "tech": "bondTracker.beginDistribution(...) · investorList.addInvestor(BankA)",
      "badges": [
        "priv"
      ]
    },
    {
      "title": "Bank A subscribes",
      "plain": "Bank A and the custodian open a second privacy group and record a subscription for 100 units. The issuer is not in this group — it never learns who subscribed.",
      "tech": "newPrivacyGroup({ members:[investor,custodian] }) · BondSubscription(units:100)",
      "badges": [
        "priv",
        "pub"
      ]
    },
    {
      "title": "Lock the cash and lock the bond",
      "plain": "Both legs are escrowed. Bank A locks 100 USDC on Sepolia (public). The custodian locks 100 bond units privately and prepares — but does not execute — an unlock to Bank A.",
      "tech": "notoCash.lock(...) · prepareUnlock(...) → cashLockId, bondLockId",
      "badges": [
        "priv",
        "pub"
      ]
    },
    {
      "title": "Assemble the Atom (bind both legs)",
      "plain": "A single immutable Atom contract is deployed on the base ledger binding the two prepared transfers. It can only execute all-or-nothing, never partially.",
      "tech": "AtomFactory.create([cashUnlock, bondUnlock]) → atom 0x9f…3a",
      "badges": [
        "pub"
      ]
    },
    {
      "title": "Execute the atomic swap (DvP)",
      "plain": "The custodian fires the Atom. In one base-ledger transaction, 100 USDC moves to the custodian and 100 bond units move to Bank A. Neither party can be left short.",
      "tech": "atom.execute() → unlock USDC → custodian · unlock BOND → BankA · tracker.supply−−",
      "badges": [
        "priv",
        "pub"
      ],
      "motion": [
        {
          "label": "USDC 100",
          "tone": "pub",
          "from": "sepolia",
          "to": "custodian"
        },
        {
          "label": "BOND 100",
          "tone": "priv",
          "from": "custodian",
          "to": "investor"
        }
      ]
    },
    {
      "title": "Settled · public anchors updated",
      "plain": "The trade is done. The public bond tracker now shows 900 available; both privacy-group state roots are re-anchored as fresh hashes. Privacy held throughout.",
      "tech": "state roots updated · public tracker available = 900",
      "badges": [
        "pub"
      ]
    }
  ],
