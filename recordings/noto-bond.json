  "steps": [
    {
      "title": "CSD issues the bond on the consortium ledger",
      "plain": "The Central Securities Depository deploys a private Noto bond token and is its notary. The base ledger records only that the contract exists.",
      "tech": "Noto.newNoto({ name:\"BOND\", notary: csd, notaryMode:\"basic\" }) → 0x06dd9ab3bc74f74112823933d0253ea0fd576a8d",
      "badges": [
        "perm"
      ]
    },
    {
      "title": "CSD mints 1,000 BOND to Bank A",
      "plain": "Only the notary and the recipient (Bank A) can see the amount. Other consortium members see only that an issuance happened.",
      "tech": "bond.mint({ to: bankA, amount: 1000 })",
      "badges": [
        "priv",
        "perm"
      ],
      "motion": [
        {
          "label": "BOND 1,000",
          "tone": "priv",
          "see": [
            "csd",
            "bankA"
          ],
          "from": "csd",
          "to": "bankA"
        }
      ]
    },
    {
      "title": "Bank A transfers 300 BOND to Bank B",
      "plain": "The notary, Bank A (sender) and Bank B (receiver) see the amount — Bank A even keeps visibility of Bank B's new note. The observer sees only that a transfer occurred; the public sees nothing.",
      "tech": "bond.transfer({ to: bankB, amount: 300 })",
      "badges": [
        "priv",
        "perm"
      ],
      "motion": [
        {
          "label": "BOND 300",
          "tone": "priv",
          "see": [
            "csd",
            "bankA",
            "bankB"
          ],
          "from": "bankA",
          "to": "bankB"
        }
      ]
    }
  ],
